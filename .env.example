# ==============================================================================
# AetherStore Unified Root Environment Configuration (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:password@postgres:5432/ecommerce_db

# Cache & Message Queue Configuration (Redis)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Backend API Configuration
BACKEND_PORT=5000

# Stripe Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=/api
